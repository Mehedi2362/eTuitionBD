{
    // ─────────────────────────────────────────────────────────────────────────────
    // IMPORTS
    // ─────────────────────────────────────────────────────────────────────────────
    "Import Form (alias)": {
        "prefix": "i;form",
        "body": ["import {", "    Form,", "    FormField as Field,", "    FormItem as Item,", "    FormLabel as Label,", "    FormControl as Control,", "    FormDescription as Description,", "    FormMessage as Message,", "} from '@/components/ui/form'"],
        "description": "Import Form components with aliases",
    },
    "Import Form (full)": {
        "prefix": "i;fform",
        "body": ["import {", "    useFormField,", "    Form,", "    FormItem,", "    FormLabel,", "    FormControl,", "    FormDescription,", "    FormMessage,", "    FormField,", "} from '@/components/ui/form'"],
        "description": "Import Form components with full names",
    },

    // ─────────────────────────────────────────────────────────────────────────────
    // USAGE - ALIAS VERSION (Short JSX names)
    // ─────────────────────────────────────────────────────────────────────────────
    "Form Field (alias)": {
        "prefix": ";formfield",
        "body": ["<Field", "    control={form.control}", "    name=\"${1:fieldName}\"", "    render={({ field }) => (", "        <Item>", "            <Label>${2:Label}</Label>", "            <Control>", "                <Input placeholder=\"${3:placeholder}\" {...field} />", "            </Control>", "            <Description>${4:Description text}</Description>", "            <Message />", "        </Item>", "    )}", "/>"],
        "description": "Form Field with aliased JSX",
    },
    "Form Field Basic (alias)": {
        "prefix": ";formfieldb",
        "body": ["<Field", "    control={form.control}", "    name=\"${1:fieldName}\"", "    render={({ field }) => (", "        <Item>", "            <Label>${2:Label}</Label>", "            <Control>", "                <Input {...field} />", "            </Control>", "            <Message />", "        </Item>", "    )}", "/>"],
        "description": "Basic Form Field (aliased)",
    },
    "Form Item (alias)": {
        "prefix": ";formitem",
        "body": ["<Item>", "    <Label>${1:Label}</Label>", "    <Control>", "        ${2:Input component}", "    </Control>", "    <Message />", "</Item>"],
        "description": "Form Item (aliased)",
    },

    // ─────────────────────────────────────────────────────────────────────────────
    // USAGE - FULL VERSION (Full component names)
    // ─────────────────────────────────────────────────────────────────────────────
    "Form Field (full)": {
        "prefix": ";fformfield",
        "body": ["<FormField", "    control={form.control}", "    name=\"${1:fieldName}\"", "    render={({ field }) => (", "        <FormItem>", "            <FormLabel>${2:Label}</FormLabel>", "            <FormControl>", "                <Input placeholder=\"${3:placeholder}\" {...field} />", "            </FormControl>", "            <FormDescription>${4:Description text}</FormDescription>", "            <FormMessage />", "        </FormItem>", "    )}", "/>"],
        "description": "Form Field with full component names",
    },
    "Form Field Basic (full)": {
        "prefix": ";fformfieldb",
        "body": ["<FormField", "    control={form.control}", "    name=\"${1:fieldName}\"", "    render={({ field }) => (", "        <FormItem>", "            <FormLabel>${2:Label}</FormLabel>", "            <FormControl>", "                <Input {...field} />", "            </FormControl>", "            <FormMessage />", "        </FormItem>", "    )}", "/>"],
        "description": "Basic Form Field (full)",
    },
    "Form with useForm (full)": {
        "prefix": ";fformsetup",
        "body": ["const form = useForm<z.infer<typeof ${1:formSchema}>>({", "    resolver: zodResolver($1),", "    defaultValues: {", "        ${2:field}: \"${3:}\",", "    },", "})", "", "function onSubmit(values: z.infer<typeof $1>) {", "    console.log(values)", "}", "", "<Form {...form}>", "    <form onSubmit={form.handleSubmit(onSubmit)} className=\"space-y-8\">", "        <FormField", "            control={form.control}", "            name=\"$2\"", "            render={({ field }) => (", "                <FormItem>", "                    <FormLabel>${4:Label}</FormLabel>", "                    <FormControl>", "                        <Input placeholder=\"${5:placeholder}\" {...field} />", "                    </FormControl>", "                    <FormDescription>${6:Description}</FormDescription>", "                    <FormMessage />", "                </FormItem>", "            )}", "        />", "        <Button type=\"submit\">Submit</Button>", "    </form>", "</Form>"],
        "description": "Complete Form setup with useForm and Zod",
    },
    "Form Item (full)": {
        "prefix": ";fformitem",
        "body": ["<FormItem>", "    <FormLabel>${1:Label}</FormLabel>", "    <FormControl>", "        ${2:Input component}", "    </FormControl>", "    <FormMessage />", "</FormItem>"],
        "description": "Form Item (full)",
    },
}
