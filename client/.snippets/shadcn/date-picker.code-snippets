    // ─────────────────────────────────────────────────────────────────────────────
    // UTILITIES
    // ─────────────────────────────────────────────────────────────────────────────
    "DatePicker State": {
        "prefix": ";datepickerstate",
        "body": ["const [date, setDate] = React.useState<Date>()"],
        "description": "DatePicker state hook",
    },
    "DatePicker Range (full)": {
        "prefix": ";fdatepickerrange",
        "body": ["const [dateRange, setDateRange] = React.useState<DateRange | undefined>({", "    from: new Date(),", "    to: addDays(new Date(), 7),", "})", "", "<Popover>", "    <PopoverTrigger asChild>", "        <Button variant=\"outline\" className=\"w-[300px] justify-start text-left\">", "            <CalendarIcon className=\"mr-2 h-4 w-4\" />", "            {dateRange?.from ? (", "                dateRange.to ? (", "                    <>", "                        {format(dateRange.from, 'LLL dd, y')} - {format(dateRange.to, 'LLL dd, y')}", "                    </>", "                ) : (", "                    format(dateRange.from, 'LLL dd, y')", "                )", "            ) : (", "                <span>Pick a date range</span>", "            )}", "        </Button>", "    </PopoverTrigger>", "    <PopoverContent className=\"w-auto p-0\" align=\"start\">", "        <Calendar", "            mode=\"range\"", "            defaultMonth={dateRange?.from}", "            selected={dateRange}", "            onSelect={setDateRange}", "            numberOfMonths={2}", "        />", "    </PopoverContent>", "</Popover>$0"],
        "description": "DatePicker with date range",
    },
