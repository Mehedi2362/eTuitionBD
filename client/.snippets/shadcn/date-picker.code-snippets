    "DatePicker (alias)": {
        "prefix": ";datepicker",
        "body": ["const [date, setDate] = React.useState<Date>()", "", "<Popover>", "    <Trigger asChild>", "        <Button", "            variant=\"outline\"", "            className={cn(", "                'w-[280px] justify-start text-left font-normal',", "                !date && 'text-muted-foreground'", "            )}", "        >", "            <CalendarIcon className=\"mr-2 h-4 w-4\" />", "            {date ? format(date, 'PPP') : <span>${1:Pick a date}</span>}", "        </Button>", "    </Trigger>", "    <Content className=\"w-auto p-0\">", "        <Calendar", "            mode=\"single\"", "            selected={date}", "            onSelect={setDate}", "            initialFocus", "        />", "    </Content>", "</Popover>$0"],
        "description": "DatePicker with aliased JSX",
    },
    "DatePicker Basic (alias)": {
        "prefix": ";datepickerb",
        "body": ["<Popover>", "    <Trigger asChild>", "        <Button variant=\"outline\">", "            <CalendarIcon className=\"mr-2 h-4 w-4\" />", "            {date ? format(date, 'PPP') : 'Pick a date'}", "        </Button>", "    </Trigger>", "    <Content className=\"w-auto p-0\">", "        <Calendar mode=\"single\" selected={date} onSelect={setDate} />", "    </Content>", "</Popover>$0"],
        "description": "Basic DatePicker (aliased)",
    },

