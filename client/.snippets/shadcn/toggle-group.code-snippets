{
    // ─────────────────────────────────────────────────────────────────────────────
    // IMPORTS
    // ─────────────────────────────────────────────────────────────────────────────
    "Import ToggleGroup (alias)": {
        "prefix": "i;togglegroup",
        "body": ["import {", "    ToggleGroup as Group,", "    ToggleGroupItem as Item,", "} from '@/components/ui/toggle-group'"],
        "description": "Import ToggleGroup components with aliases",
    },
    "Import ToggleGroup (full)": {
        "prefix": "i;ftogglegroup",
        "body": ["import { ToggleGroup, ToggleGroupItem } from '@/components/ui/toggle-group'"],
        "description": "Import ToggleGroup components with full names",
    },

    // ─────────────────────────────────────────────────────────────────────────────
    // USAGE - ALIAS VERSION (Short JSX names)
    // ─────────────────────────────────────────────────────────────────────────────
    "ToggleGroup (alias)": {
        "prefix": ";togglegroup",
        "body": ["<Group type=\"${1|single,multiple|}\" value={${2:value}} onValueChange={${3:setValue}}>", "    <Item value=\"${4:option1}\" aria-label=\"${5:Option 1}\">${6:Option 1}</Item>", "    <Item value=\"${7:option2}\" aria-label=\"${8:Option 2}\">${9:Option 2}</Item>", "    <Item value=\"${10:option3}\" aria-label=\"${11:Option 3}\">${12:Option 3}</Item>", "</Group>"],
        "description": "ToggleGroup with aliased JSX",
    },
    "ToggleGroup Basic (alias)": {
        "prefix": ";togglegroupb",
        "body": ["<Group type=\"single\">", "    <Item value=\"$1\">$2</Item>", "    <Item value=\"$3\">$4</Item>", "</Group>"],
        "description": "Basic ToggleGroup (aliased)",
    },
    "ToggleGroup Outline (alias)": {
        "prefix": ";togglegroupo",
        "body": ["<Group type=\"${1|single,multiple|}\" variant=\"outline\">", "    <Item value=\"${2:option1}\">${3:Option 1}</Item>", "    <Item value=\"${4:option2}\">${5:Option 2}</Item>", "</Group>"],
        "description": "Outline ToggleGroup (aliased)",
    },

    // ─────────────────────────────────────────────────────────────────────────────
    // USAGE - FULL VERSION (Full component names)
    // ─────────────────────────────────────────────────────────────────────────────
    "ToggleGroup (full)": {
        "prefix": ";ftogglegroup",
        "body": ["<ToggleGroup type=\"${1|single,multiple|}\" value={${2:value}} onValueChange={${3:setValue}}>", "    <ToggleGroupItem value=\"${4:option1}\" aria-label=\"${5:Option 1}\">${6:Option 1}</ToggleGroupItem>", "    <ToggleGroupItem value=\"${7:option2}\" aria-label=\"${8:Option 2}\">${9:Option 2}</ToggleGroupItem>", "    <ToggleGroupItem value=\"${10:option3}\" aria-label=\"${11:Option 3}\">${12:Option 3}</ToggleGroupItem>", "</ToggleGroup>"],
        "description": "ToggleGroup with full component names",
    },
    "ToggleGroup Basic (full)": {
        "prefix": ";ftoggleroupb",
        "body": ["<ToggleGroup type=\"single\">", "    <ToggleGroupItem value=\"$1\">$2</ToggleGroupItem>", "    <ToggleGroupItem value=\"$3\">$4</ToggleGroupItem>", "</ToggleGroup>"],
        "description": "Basic ToggleGroup (full)",
    },
    "ToggleGroup Outline (full)": {
        "prefix": ";ftogglegropo",
        "body": ["<ToggleGroup type=\"${1|single,multiple|}\" variant=\"outline\">", "    <ToggleGroupItem value=\"${2:option1}\">${3:Option 1}</ToggleGroupItem>", "    <ToggleGroupItem value=\"${4:option2}\">${5:Option 2}</ToggleGroupItem>", "</ToggleGroup>"],
        "description": "Outline ToggleGroup (full)",
    },
}
